# Copy to .env.local for local dev (never commit .env.local)

# Supabase — Project Settings → API
# Use the base Project URL only — NOT the /rest/v1/ endpoint
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI assistant — server-side only (do not prefix with NEXT_PUBLIC_)
# xAI Grok is preferred. Vercel: Settings → Environment Variables → Production
# XAI_API_KEY=your_xai_api_key_here
# VITE_XAI_API_KEY is also read by the /api/chat route if XAI_API_KEY is unset
# OPENAI_API_KEY=sk-...